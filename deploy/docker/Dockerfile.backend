# syntax=docker/dockerfile:1.7
FROM python:3.12-slim

WORKDIR /app
COPY backend/pyproject.toml /app/backend/pyproject.toml
COPY backend/src /app/backend/src
COPY backend/proto /app/backend/proto
COPY backend/migrations /app/backend/migrations
COPY scripts/generate_proto.py /app/scripts/generate_proto.py
COPY scripts/smoke_server.py /app/scripts/smoke_server.py
COPY scripts/run_api_ingestion_smoke.py /app/scripts/run_api_ingestion_smoke.py
# AgenticPlane is distributed through a private package registry. Supply
# PIP_EXTRA_INDEX_URL as a Docker secret build argument (or a Compose build
# argument). It is used only by this build step and is not copied into the
# runtime image.
ARG PIP_EXTRA_INDEX_URL
RUN if [ -n "$PIP_EXTRA_INDEX_URL" ]; then export PIP_EXTRA_INDEX_URL; fi; \
    pip install --no-cache-dir setuptools wheel \
    && cd /app/backend \
    && pip install --no-cache-dir --no-build-isolation . \
    && python /app/scripts/generate_proto.py \
    && pip install --no-cache-dir --no-build-isolation --no-deps .

WORKDIR /app/backend

CMD ["python", "-m", "cce.main"]
