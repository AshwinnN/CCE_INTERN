{
  "skill": "skill-credential-resolution",
  "test_suite_version": "1.0.0",
  "test_cases": [
    {
      "id": "TC-001",
      "description": "Issues a Vault-backed lease with a deterministic id and no secret material.",
      "rule_ids": [
        "CRD03",
        "CRD06"
      ],
      "input_file": "test-data/TC-001-input.json",
      "expected": {
        "lease_id": "lse_wh_prod_snowflake",
        "credential_ref": "vault://cce/wh_prod_snowflake",
        "backend": "vault",
        "role": "CCE_READER",
        "grants": [
          "SELECT"
        ],
        "grants_write": false,
        "ttl_seconds": 3600,
        "status": "READY",
        "violated_rule": null
      }
    },
    {
      "id": "TC-002",
      "description": "Issues an AWS Secrets Manager lease with the identical field set as Vault.",
      "rule_ids": [
        "CRD02",
        "CRD07"
      ],
      "input_file": "test-data/TC-002-input.json",
      "expected": {
        "lease_id": "lse_fs_logistics_pg",
        "credential_ref": "aws-sm://cce/fs_logistics_pg",
        "backend": "aws-sm",
        "role": "ctx_engine_ro",
        "grants": [
          "SELECT",
          "USAGE"
        ],
        "grants_write": false,
        "ttl_seconds": 1800,
        "status": "READY",
        "violated_rule": null
      }
    },
    {
      "id": "TC-003",
      "description": "Issues a GCP Secret Manager lease, third backend through one path.",
      "rule_ids": [
        "CRD02",
        "CRD07"
      ],
      "input_file": "test-data/TC-003-input.json",
      "expected": {
        "lease_id": "lse_wh_bq_analytics",
        "credential_ref": "gcp-sm://cce/wh_bq_analytics",
        "backend": "gcp-sm",
        "role": "roles/bigquery.dataViewer",
        "grants": [
          "SELECT"
        ],
        "grants_write": false,
        "ttl_seconds": 900,
        "status": "READY",
        "violated_rule": null
      }
    },
    {
