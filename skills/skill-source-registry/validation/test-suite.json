    {
      "id": "TC-001",
      "description": "Registers a Snowflake structured adapter and emits its descriptor.",
      "rule_ids": [
        "REG01",
        "REG03",
        "REG06"
      ],
      "input_file": "test-data/TC-001-input.json",
      "expected": {
        "adapter": "snowflake",
        "kind": "structured",
        "dialect": "snowflake",
        "capabilities": {
          "write_probe": true,
          "statement_timeout": true,
          "row_cap": true,
          "schema_scope": true
        },
        "schema_version": "1.0",
        "deprecated": false,
        "status": "READY",
        "violated_rule": null
      }
    },
