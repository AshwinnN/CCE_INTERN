# Keep browser calls same-origin in development; Vite proxies /api to VITE_BACKEND_URL.
VITE_API_BASE_URL=/api
VITE_BACKEND_URL=http://localhost:8081

# Query calls are synchronous. Stop the UI loader if the backend has not responded.
VITE_QUERY_TIMEOUT_MS=600000

# Temporary frontend-only demo login. Values are visible to the browser.
# Replace these before sharing the MVP with others.
VITE_DEMO_USERNAME=cce-admin
VITE_DEMO_PASSWORD=cce-admin
VITE_ACTOR_ID=cce-demo-user
VITE_ACTOR_ROLES=ADMIN,STEWARD
