CCE_ENV=development
CCE_ENVIRONMENT=development
CCE_APP_NAME=cce-tool
CCE_GRPC_HOST=0.0.0.0
CCE_GRPC_PORT=50051
CCE_TENANT_ID=demo
CCE_CONTEXT_TOKEN_BUDGET=2500
CCE_QUERY_TIMEOUT_SECONDS=20
CCE_QUERY_ROW_LIMIT=500
CCE_ALLOWED_SCHEMAS=

CCE_SNOWFLAKE_ENABLED=false
CCE_SNOWFLAKE_LIVE_TESTS=false
CCE_SNOWFLAKE_AUTH_METHOD=key_pair
CCE_SNOWFLAKE_ACCOUNT=<snowflake-account>
CCE_SNOWFLAKE_USER=<snowflake-user>
CCE_SNOWFLAKE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n<private-key>\n-----END PRIVATE KEY-----
CCE_SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
CCE_SNOWFLAKE_ROLE=<snowflake-role>
CCE_SNOWFLAKE_WAREHOUSE=<snowflake-warehouse>
CCE_SNOWFLAKE_DATABASE=<snowflake-database>
CCE_SNOWFLAKE_SCHEMA=<snowflake-schema>
CCE_SNOWFLAKE_LOGIN_TIMEOUT=20
CCE_SNOWFLAKE_NETWORK_TIMEOUT=30
CCE_SNOWFLAKE_SOCKET_TIMEOUT=30
CCE_SNOWFLAKE_MAX_TABLES=5

CCE_GOOGLE_DOCS_ENABLED=false
CCE_AZURE_BLOB_ENABLED=false
CCE_AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account-name>;AccountKey=<account-key>;EndpointSuffix=core.windows.net
CCE_AZURE_BLOB_CONTAINER=<container-name>
CCE_AZURE_BLOB_PREFIX=<prefix>
CCE_MCP_ENABLED=true

CCE_DLP_CONFIDENCE_THRESHOLD=0.7
CCE_SDK_ENDPOINT=
CCE_SDK_API_KEY=
CCE_CHECKPOINT_STORE_PATH=.ingestion_checkpoints

POSTGRES_USER=cce_admin
POSTGRES_PASSWORD=cce_password
POSTGRES_DB=cce_control
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
CCE_METADATA_REPOSITORY_ENABLED=false
CCE_CONTROL_DATABASE_URL=postgresql://cce_admin:cce_password@localhost:5434/cce_control
