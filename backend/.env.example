CCE_ENV=development
CCE_ENVIRONMENT=development
CCE_APP_NAME=cce-tool
CCE_GRPC_HOST=0.0.0.0
CCE_GRPC_PORT=50051
CCE_HTTP_ENABLED=true
CCE_HTTP_PORT=8080
CCE_TENANT_ID=demo
CCE_CONTEXT_TOKEN_BUDGET=2500
CCE_QUERY_TIMEOUT_SECONDS=20
CCE_QUERY_ROW_LIMIT=500
CCE_ALLOWED_SCHEMAS=

CCE_SNOWFLAKE_ENABLED=false
CCE_SNOWFLAKE_SOURCE_ID=cce-snowflake-test
CCE_SNOWFLAKE_LIVE_TESTS=false
CCE_SNOWFLAKE_AUTH_METHOD=key_pair
CCE_SNOWFLAKE_ACCOUNT=<snowflake-account>
CCE_SNOWFLAKE_USER=<snowflake-user>
CCE_SNOWFLAKE_PRIVATE_KEY=azure-kv://<vault-name>/<snowflake-private-key-secret>
CCE_SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=env://<local-dev-passphrase-var>
CCE_SNOWFLAKE_ROLE=<snowflake-role>
CCE_SNOWFLAKE_WAREHOUSE=<snowflake-warehouse>
CCE_SNOWFLAKE_DATABASE=<snowflake-database>
CCE_SNOWFLAKE_SCHEMA=<snowflake-schema>
CCE_SNOWFLAKE_LOGIN_TIMEOUT=20
CCE_SNOWFLAKE_NETWORK_TIMEOUT=30
CCE_SNOWFLAKE_SOCKET_TIMEOUT=30
CCE_SNOWFLAKE_MAX_TABLES=5

CCE_GOOGLE_DOCS_ENABLED=false
CCE_AZURE_BLOB_ENABLED=false
CCE_AZURE_BLOB_SOURCE_ID=cce-azure-blob-test
CCE_AZURE_BLOB_CONNECTION_STRING=azure-kv://<vault-name>/<azure-blob-connection-string-secret>
CCE_AZURE_BLOB_CONTAINER=<container-name>
CCE_AZURE_BLOB_PREFIX=<prefix>
CCE_AZURE_BLOB_MAX_FILES=10
CCE_MCP_ENABLED=true

CCE_DLP_CONFIDENCE_THRESHOLD=0.7
CCE_SDK_ENDPOINT=
CCE_SDK_API_KEY=
CCE_CHECKPOINT_STORE_PATH=.ingestion_checkpoints

POSTGRES_USER=cce_admin
POSTGRES_PASSWORD=cce_password
POSTGRES_DB=cce_control
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
CCE_METADATA_REPOSITORY_ENABLED=false
CCE_CONTROL_DATABASE_URL=postgresql://cce_admin:cce_password@localhost:5434/cce_control
CCE_MIGRATE_ON_STARTUP=true
CCE_POSTGRES_WAIT_TIMEOUT_SECONDS=60
CCE_INDEX_BACKEND=local
# Required when CCE_INDEX_BACKEND=agentic_plane.
CCE_AGENTICPLANE_BASE_URL=
CCE_AGENTICPLANE_API_KEY=
CCE_AGENTICPLANE_TIMEOUT=30
CCE_AGENTICPLANE_MAX_RETRIES=3
CCE_AGENTICPLANE_AGENT_ID=cce-ingestion
# Also extract entities/relationships into the AgenticPlane knowledge graph
# for each stored chunk (in addition to vector storage). Requires
# GRAPH_ENABLED=true on the AgenticPlane gateway; a per-chunk extraction
# failure is logged and skipped rather than failing the whole index() call.
CCE_AGENTICPLANE_GRAPH_ENABLED=true
# Hosted prerequisite: AgenticPlane GRAPH_ENABLED=true and ArcadeDB running
# (docker compose --profile graph up on an AgenticPlane deployment).
# Manual register -> ingest -> retrieve smoke only; not read by the CCE server.
CCE_LIVE_AGENTICPLANE_GRAPH_SMOKE=false
CCE_AGENTICPLANE_GRAPH_SMOKE_QUESTION=
CCE_HTTP_BASE_URL=http://localhost:8080
CCE_LOCAL_INDEX_EMBEDDING_MODE=
CCE_EMBEDDING_MODEL=models/text-embedding-004

# Alternative production patterns:
# CCE_CONTROL_DATABASE_CREDENTIAL_REF=azure-kv://<vault-name>/<postgres-dsn-secret>
# CCE_CONTROL_DATABASE_CREDENTIAL_REF=azure-kv://<vault-name>/<postgres-password-secret>
# CCE_AZURE_CLIENT_ID=<service-principal-client-id>
# CCE_AZURE_CLIENT_SECRET=<service-principal-client-secret>
# CCE_AZURE_TENANT_ID=<tenant-id>

CCE_LLM_PROVIDER=gemini
CCE_LLM_MODEL=gemini-2.5-flash
CCE_LLM_API_KEY=
# Required when CCE_LLM_PROVIDER=litellm: URL of the LiteLLM proxy. The proxy
# is OpenAI-protocol compatible, so CCE_LLM_API_KEY/CCE_LLM_MODEL are reused.
CCE_LLM_BASE_URL=
CCE_LLM_TIMEOUT=300
CCE_LLM_MAX_RETRIES=1
CCE_LLM_MAX_TOKENS=

# Governed lifecycle / query runtime
CCE_INGESTION_MAX_CONCURRENCY=5
CCE_DOMAIN_DETECTION_MIN_CONFIDENCE=0.7
CCE_DOMAIN_MAX_MATCHES=3
CCE_DOMAIN_MIN_CONFIDENCE=0.7
CCE_RETRIEVAL_TOP_K=10
CCE_RETRIEVAL_OVERSAMPLE_FACTOR=3
CCE_RETRIEVAL_MIN_SCORE=0.7
CCE_GRAPH_MAX_HOPS=2
CCE_SQL_GENERATION_ENABLED=true
CCE_SQL_MAX_RETRIES=2
CCE_SQL_TIMEOUT_SECONDS=30
CCE_SQL_MAX_ROWS=1000
CCE_CONTEXT_OFF_ENABLED=true
CCE_QUERY_INCLUDE_ROWS=true
CCE_JOB_LEASE_SECONDS=120
CCE_JOB_POLL_SECONDS=2
CCE_LLM_DOMAIN_MODEL=
CCE_LLM_EXTRACTION_MODEL=
CCE_LLM_SQL_MODEL=
CCE_LLM_ANSWER_MODEL=
CCE_LLM_PROOF_MODEL=
