CCE_ENV=development
CCE_APP_NAME=cce-tool
CCE_DATABASE_URL=sqlite:///./data/cce.db
CCE_TENANT_ID=demo
CCE_CONTEXT_TOKEN_BUDGET=2500
CCE_QUERY_TIMEOUT_SECONDS=20
CCE_QUERY_ROW_LIMIT=500
CCE_ALLOWED_SCHEMAS=
CCE_ARCADEDB_ENABLED=false
CCE_ARCADEDB_BASE_URL=http://localhost:2480
CCE_ARCADEDB_DATABASE=cce
CCE_ARCADEDB_USERNAME=root
CCE_ARCADEDB_PASSWORD=
CCE_SNOWFLAKE_ENABLED=false
CCE_SNOWFLAKE_AUTH_METHOD=key_pair
CCE_SNOWFLAKE_ACCOUNT=
CCE_SNOWFLAKE_USER=
CCE_SNOWFLAKE_PRIVATE_KEY=
CCE_SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
CCE_SNOWFLAKE_ROLE=
CCE_SNOWFLAKE_WAREHOUSE=
CCE_SNOWFLAKE_DATABASE=
CCE_SNOWFLAKE_SCHEMA=
CCE_SNOWFLAKE_LOGIN_TIMEOUT=20
CCE_SNOWFLAKE_NETWORK_TIMEOUT=30
CCE_SNOWFLAKE_SOCKET_TIMEOUT=30
CCE_GOOGLE_DOCS_ENABLED=false
CCE_AZURE_BLOB_ENABLED=false
CCE_AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account-name>;AccountKey=<account-key>;EndpointSuffix=core.windows.net
CCE_AZURE_BLOB_CONTAINER=cce-sa
CCE_AZURE_BLOB_PREFIX=noaa_data
CCE_MCP_ENABLED=true

# Ingestion workflow (agents/ingestion_workflow.py)
CCE_DLP_CONFIDENCE_THRESHOLD=0.7
CCE_SDK_ENDPOINT=
CCE_SDK_API_KEY=
CCE_CHECKPOINT_STORE_PATH=.ingestion_checkpoints

# Local Postgres metadata repository (docker-compose.yaml)
POSTGRES_USER=cce_admin
POSTGRES_PASSWORD=cce_password
POSTGRES_DB=cce_metadata
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
CCE_METADATA_DATABASE_URL=postgresql://cce_admin:cce_password@localhost:5434/cce_metadata

# AgenticPlane SDK integration
# Optional module:factory path that returns the application's existing plane instance.
CCE_AGENTICPLANE_FACTORY=
